# This list was built by grepping `process.env[` across packages/ and scripts/,
# plus a direct check of the DRS bash hook and DRSService.ts — re-verify if new
# env-var reads are added. (Verified 2026-09-10; TOTO_DRS_CONFIG added after
# drs-enforcement-remediation landed and made it a real, live read.)

# Anthropic credentials (one of API_KEY or AUTH_TOKEN required)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Vault location override (defaults to ~/.toto/vault)
TOTO_VAULT_PATH=
VAULT_PATH=

# Dashboard HTTP server port (default 3099)
TOTO_MCP_PORT=

# Radio command (optional local-model routing)
TOTO_RADIO_PROVIDER=
TOTO_RADIO_MODEL=
OLLAMA_HOST=

# DRS override (bash hook path only — set to bypass Rules 2/3/4 with a reason)
DRS_OVERRIDE_REASON=

# DRS config path override (TS/MCP path escape hatch — takes precedence over
# the default cwd-relative .toto/drs-config.json lookup)
TOTO_DRS_CONFIG=
